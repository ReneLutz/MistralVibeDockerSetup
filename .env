# chmod 600 .env  — may hold a secret.
# Authentication - pick ONE mode:
#  a) Browser OAuth (default): leave MISTRAL_API_KEY empty, sign in on
#     first run (vibe --setup). Credentials persist in ./home/.vibe.
#  b) API key: paste it here; it then OVERRIDES browser credentials.
#     Create at https://chat.mistral.ai/code/extensions
MISTRAL_API_KEY=

# Your WSL user (id -u / id -g) so files created in the project are owned by you.
UID=1000
GID=1000

# Pin the CLI version once you've verified it works, e.g.:
# VIBE_VERSION=0.9.0
VIBE_VERSION=
